PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_chatbot?schema=public"
GEMINI_API_KEY="your-gemini-api-key"
# Speech-to-text uses Gemini only (no OpenAI Whisper). Do not set Whisper_api_key — it is not used.
# Recommended for free tier: gemini-2.5-flash-lite (gemini-2.0-flash may show quota limit 0)
GEMINI_MODEL="gemini-2.5-flash-lite"
# How many retries on quota/rate errors (each wait grows: ~1.5s, 3s, 6s...)
GEMINI_RETRY_MAX="3"
# Optional comma-separated allowlist for non-localhost origins in development.
# Local http://localhost:* and http://127.0.0.1:* are allowed automatically when NODE_ENV is not production.
CORS_ORIGIN=""
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Voice: max upload size in bytes (default 10MB)
VOICE_MAX_BYTES="10485760"
VOICE_RATE_LIMIT_PER_MIN="20"
# Server TTS via Microsoft Edge (free, no API key). Use a voice id or "auto" per detected language.
# Examples: auto | en-US-JennyNeural | hi-IN-SwaraNeural
TTS_VOICE_DEFAULT="auto"
# Push-to-talk only: one Gemini call for transcribe + reply (faster; default off)
VOICE_SINGLE_CALL="false"
