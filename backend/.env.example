PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_chatbot?schema=public"
GEMINI_API_KEY="your-gemini-api-key"
# Optional: e.g. gemini-2.0-flash, gemini-1.5-flash (different models may have different free-tier limits)
GEMINI_MODEL="gemini-2.0-flash"
# How many retries on quota/rate errors (each wait grows: ~1.5s, 3s, 6s...)
GEMINI_RETRY_MAX="3"
# Optional comma-separated allowlist for non-localhost origins in development.
# Local http://localhost:* and http://127.0.0.1:* are allowed automatically when NODE_ENV is not production.
CORS_ORIGIN=""
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
