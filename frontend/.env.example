# Override where Vite proxies /api and /socket.io in dev (recommended when the API
# is not on the same port as ../backend/.env PORT — e.g. docker-compose maps API to :5000).
#
# Copy to frontend/.env or .env.local and uncomment:
# VITE_DEV_API_TARGET=http://127.0.0.1:5000
#
# Production (Docker/nginx on :80): leave VITE_API_URL unset; browser uses same origin.
# Ensure backend CORS_ORIGIN includes your public URL (e.g. http://localhost for Docker).
#
# Vercel + Render (option A — recommended): edit frontend/vercel.json with your Render URL;
# leave VITE_API_URL unset on Vercel so /api and /socket.io proxy to Render.
#
# Vercel + Render (option B): set VITE_API_URL to your Render URL (no trailing slash), e.g.
# VITE_API_URL=https://your-service.onrender.com
# Also set Render CORS_ORIGIN to your Vercel URL. Do not use vercel.json rewrites with option B.
#
# If unset in dev: vite reads PORT from ../backend/.env, else http://127.0.0.1:5000.

# Set to "false" to disable SSE streaming for text chat (uses regular POST /api/chat).
# VITE_CHAT_STREAM=false
