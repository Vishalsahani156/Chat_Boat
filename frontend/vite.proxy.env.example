# Override where Vite proxies /api and /socket.io in dev.
#
# Typical: DockerCompose exposes the API on host :5000 but ../backend/.env has PORT=3000
# for local Node — set this in frontend/.env so Vite does not proxy to the wrong port.
#
# VITE_DEV_API_TARGET=http://127.0.0.1:5000
#
# If unset: vite reads PORT from ../backend/.env, else http://127.0.0.1:5000.
