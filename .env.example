# Root env for Docker Compose (copy to .env)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
VOICE_MAX_BYTES=10485760
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Optional: override Edge TTS voice for all languages (default: auto)
# TTS_VOICE_DEFAULT=auto
